<title>TNT · Direct forces and interpolated grids · 18 October 2026</title>
<style>
:root{--paper:#f6f5f0;--surface:#fffefa;--ink:#172f39;--muted:#52646a;--line:#d5dbd6;--accent:#14665d;--direct:#234e70;--coarse:#ae6410;--medium:#35774f;--fine:#a3434d;--wash:#e9f0ea;--warn:#79551c;font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--ink);background:var(--paper);font-size:16px;line-height:1.6}
*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0}a{color:var(--accent);text-underline-offset:3px}button,select{font:inherit;color:inherit}button,.button{background:var(--surface);border:1px solid #a9b8b4;padding:9px 14px;border-radius:5px;cursor:pointer;text-decoration:none;display:inline-block;font-weight:600}button:hover,.button:hover{background:var(--wash)}button:disabled{opacity:.5;cursor:not-allowed}:focus-visible{outline:3px solid #167baf;outline-offset:3px}select{background:var(--surface);border:1px solid #a9b8b4;border-radius:4px;max-width:100%;padding:9px 30px 9px 10px;min-height:44px}label{display:flex;flex-direction:column;gap:5px;font-weight:600;font-size:.86rem}button.primary{background:var(--accent);color:#fff;border-color:var(--accent)}.wrap{max-width:1180px;margin:auto;padding:0 30px}.topbar{border-bottom:1px solid var(--line);background:var(--paper);position:sticky;top:0;z-index:5}.topline{display:flex;align-items:center;justify-content:space-between;gap:20px;min-height:66px}.brand{font-weight:800;letter-spacing:.1em;text-decoration:none;color:var(--ink)}.brand span{font-size:.75rem;font-weight:500;letter-spacing:.03em;color:var(--muted);margin-left:12px}.toplinks{display:flex;gap:18px;align-items:center;font-size:.85rem}.toplinks a{color:var(--ink);text-decoration:none}.toplinks a:hover{text-decoration:underline}.eyebrow{text-transform:uppercase;font-size:.74rem;font-weight:750;letter-spacing:.12em;color:var(--accent);margin:0 0 16px}.hero{padding:58px 0 35px}.hero h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;font-size:clamp(2.3rem,5.2vw,4.5rem);line-height:1.09;letter-spacing:-.035em;max-width:900px;margin:0 0 25px}.lead{max-width:790px;font-size:1.15rem;color:var(--muted)}.protocol{font-size:.87rem;display:flex;flex-wrap:wrap;gap:8px 24px;color:var(--muted);margin-top:25px}.recommendation{background:var(--wash);border-left:4px solid var(--accent);padding:24px 28px;margin:28px 0 0}.recommendation h2{margin:0 0 7px;font-size:1.35rem}.recommendation p{margin:0;max-width:890px}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;padding:25px 0 5px}.fact{border-top:1px solid var(--line);padding-top:15px}.fact strong{display:block;font-size:1.65rem;font-weight:650;font-variant-numeric:tabular-nums;line-height:1.3}.fact span{color:var(--muted);font-size:.85rem}.section{padding:40px 0 46px;border-top:1px solid var(--line)}.section-head{display:flex;justify-content:space-between;align-items:flex-start;gap:20px;margin-bottom:22px}.section h2{font-family:Georgia,"Times New Roman",serif;font-size:2rem;font-weight:400;letter-spacing:-.025em;line-height:1.2;margin:0 0 10px}.section h3{font-size:1rem;line-height:1.4;margin:0 0 8px}.section-head p{margin:0;max-width:760px;color:var(--muted)}.controls{display:flex;gap:18px;flex-wrap:wrap;align-items:end;padding:17px 0 21px}.controls label{flex:1 1 200px;max-width:380px}.two{display:grid;grid-template-columns:1fr 1fr;gap:30px}.two>*{min-width:0}.plot{min-width:0}.plot svg{display:block;width:100%;height:auto;overflow:visible}.plot text{font-family:system-ui,sans-serif;fill:var(--ink);font-size:12px}.plot .grid{stroke:var(--line);stroke-width:1}.plot .axis{stroke:#839791;stroke-width:1}.plot .bar-value{font-size:12px;font-weight:650}.legend{display:flex;flex-wrap:wrap;gap:15px;font-size:.85rem;margin:6px 0 15px}.swatch{display:inline-block;width:10px;height:10px;margin-right:6px;background:var(--c)}.note{font-size:.85rem;color:var(--muted);margin:12px 0 0}.notice{background:#f1ebdf;border-left:3px solid #b18a49;padding:13px 16px;font-size:.88rem;margin:18px 0;color:#624b21}.table-scroll{overflow-x:auto;max-width:100%;margin:18px 0}table{border-collapse:collapse;width:100%;font-size:.85rem;font-variant-numeric:tabular-nums}th,td{text-align:right;padding:12px 10px;border-bottom:1px solid var(--line);vertical-align:top}th{font-weight:650;color:var(--muted);font-size:.78rem}th:first-child,td:first-child{text-align:left}tbody tr.selected{background:var(--wash)}caption{text-align:left;font-size:.8rem;color:var(--muted);padding:8px 0}code{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.88em;background:#e9ede6;padding:2px 4px;border-radius:3px;overflow-wrap:anywhere}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#eef0e9;padding:18px;font-size:.8rem;max-width:100%}pre code{padding:0;background:none}.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:18px 0 22px}.metric-grid div{border-top:1px solid var(--line);padding-top:12px}.metric-grid span{display:block;font-size:.8rem;color:var(--muted)}.metric-grid strong{display:block;font-size:1.3rem;font-variant-numeric:tabular-nums}.asset{display:grid;grid-template-columns:minmax(180px,1fr) auto;gap:14px;border-bottom:1px solid var(--line);padding:18px 0;align-items:center}.asset small{display:block;color:var(--muted);overflow-wrap:anywhere;font-size:.72rem}.actions{display:flex;flex-wrap:wrap;gap:9px}.actions button{font-size:.82rem}.asset h3{font-family:ui-monospace,monospace;font-size:.88rem}.complete{margin-top:24px;border-top:1px solid var(--line);padding-top:20px}.complete>summary{cursor:pointer;font-weight:650;padding:12px 0}.report{max-width:980px;margin:25px auto}.report h1{font-family:Georgia,serif;font-size:2rem;font-weight:400}.report h2{font-size:1.55rem;margin-top:45px}.report h3{margin-top:30px}.report table{display:block;overflow-x:auto;white-space:normal;margin:22px 0}.report th,.report td{min-width:110px}.report p,.report li{font-size:.94rem}.report li{margin:6px 0}.report img{max-width:100%}.figure{margin:20px 0}.figure img{width:100%;height:auto;background:#fff;display:block;border:1px solid var(--line)}figcaption{font-size:.83rem;color:var(--muted);margin-top:12px}.footer{padding:30px 0 50px;border-top:1px solid var(--line);color:var(--muted);font-size:.8rem}.tooltip{position:fixed;pointer-events:none;z-index:10;background:var(--ink);color:white;padding:9px 12px;border-radius:4px;font-size:.8rem;max-width:280px;box-shadow:0 3px 15px #0002;white-space:pre-line}.offscreen{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.status{font-size:.85rem;min-height:24px;color:var(--accent)}.nojs{border:2px solid #ad7620;padding:15px;margin:20px 0}.print-only{display:none}
@media(max-width:760px){.wrap{padding:0 18px}.topline{min-height:60px;flex-wrap:wrap;padding-top:12px;padding-bottom:12px;gap:10px}.brand span{display:none}.toplinks{gap:12px;font-size:.78rem;flex-wrap:wrap}.toplinks button{padding:6px 10px;font-size:.8rem}.hero{padding-top:35px}.two{grid-template-columns:1fr;gap:28px}.facts{gap:14px}.fact strong{font-size:1.3rem}.metric-grid{grid-template-columns:repeat(2,1fr)}.section-head{display:block}.asset{grid-template-columns:1fr}.recommendation{padding:20px}.section{padding:30px 0}.controls label{max-width:none}.plot text{font-size:12px}.topbar{position:static}html{scroll-padding-top:12px}.report table{font-size:.8rem}.facts .fact span{font-size:.78rem}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
@media print{body{background:white;color:#172f39;font-size:10pt}.wrap{max-width:none;padding:0}.topbar,.controls,.actions,.legend,.no-print,button,.tooltip{display:none!important}.hero{padding-top:0}.hero h1{font-size:30pt}.section{padding:18px 0;break-before:auto}.section h2{font-size:20pt}.two{grid-template-columns:1fr 1fr;gap:14px}.plot,.recommendation,figure{break-inside:avoid}.complete{display:block}.complete>summary{font-size:18pt}.report table{display:table;overflow:visible;font-size:8pt}.report td,.report th{min-width:0;padding:7px 5px}.report h2{font-size:17pt}.print-only{display:block}.asset{break-inside:avoid}a{color:inherit}.data-section{display:none}.footer{padding-bottom:0}.figure img{max-height:650px;object-fit:contain}}
